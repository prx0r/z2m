{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISec Normalized Finding",
  "type": "object",
  "required": [
    "finding_id",
    "platform",
    "program",
    "target",
    "title",
    "summary",
    "impact",
    "scope_snapshot_sha256",
    "authorization_token_id"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "program_url": {
      "type": "string",
      "format": "uri"
    },
    "target": {
      "type": "string"
    },
    "scope_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "authorization_token_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "severity_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps_to_reproduce": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_by_human": {
      "type": "boolean",
      "default": false
    },
    "human_approval_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}