# AgentBuild local configuration.
# Copy to .env.local or run: agentbuild configure ...

# Aether orchestrator provider. Supported by current Aether releases:
# anthropic, openai, openrouter, deepseek, fireworks, gemini, moonshot, zai
AGENTBUILD_PROVIDER=openrouter
AGENTBUILD_ORCHESTRATOR_MODEL=openrouter:xiaomi/mimo-v2.5
AGENTBUILD_REASONING_EFFORT=high

# Put ONE matching provider key here. agentbuild configure writes this for you.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# FIREWORKS_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# sandboxd
SANDBOXD_URL=http://127.0.0.1:9090
SANDBOXD_API_TOKEN=
SANDBOXD_DEFAULT_AGENT=opencode
SANDBOXD_BUILDER_MODEL=
SANDBOXD_TASK_TIMEOUT_S=1800

# Build policy
AGENTBUILD_MODE=aether
AGENTBUILD_MAX_REPAIR_LOOPS=3
AGENTBUILD_RUNTIME_PRESET=react-vite
AGENTBUILD_PREVIEW_PORT=3000

# Optional finalbuilds graduation target
FINALBUILDS_PATH=
