# Core
Q4RADAR_DB=data/q4radar.sqlite3
Q4RADAR_CONFIG_DIR=config

# Optional: Google Ads Keyword Planner (strongest live demand source)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional: SerpApi Google Shopping / Trends fallback
SERPAPI_KEY=

# Optional: CJdropshipping API v2
CJ_ACCESS_TOKEN=

# Optional: Meta Ad Library. Access/coverage depends on Meta permissions and market.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# Optional: official Google Trends alpha. Set only after your alpha docs provide an endpoint.
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_ACCESS_TOKEN=

# Optional OpenAI-compatible LLM for copy/positioning enrichment.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
